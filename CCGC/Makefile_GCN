#---------------------------------------------------------------------------------
# Castle Crashers for GameCube: an Octave C++ project around the engine of
# the Castle-Crashers-Recomp repository (a checkout next to this one).
#
# Normally built by Octave's packager:
#   Octave.exe -headless -project <path>/CCGC.octp -build GameCube
# which runs this makefile, then writes Packaged/GameCube/ (.dol + .iso).
#
# By hand: make -f Makefile_GCN  -> Build/GCN/CCGC.dol
# Links the prebuilt Octave engine (octave-libogc Engine/Makefile_GCN).
#---------------------------------------------------------------------------------
.SUFFIXES:
.SECONDARY:

ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/gamecube_rules

export OCTAVE ?= $(abspath $(CURDIR)/../../octave-libogc)
# The engine, and the libraries its PC build fetches (libtess2, stb): build
# the PC version once (cmake) to get them.
export CC_REPO ?= $(abspath $(CURDIR)/../../CastleCrashersRecomp)
export CASTLE := $(CC_REPO)/engine
export DEPS ?= $(CC_REPO)/build/_deps

TARGET		:=	CCGC
BUILD		:=	Intermediate/GCN
SOURCES		:=	Source Generated \
				$(CASTLE)/as $(CASTLE)/audio $(CASTLE)/common $(CASTLE)/input $(CASTLE)/menu \
				$(CASTLE)/player $(CASTLE)/save $(CASTLE)/swf $(CASTLE)/text \
				$(DEPS)/libtess2-src/Source
OUTPUT_DIR	:=	$(CURDIR)/Build/GCN

# The PC's own: its main, OpenGL renderer, file reads, crash handler, PNG
# writer and state dumps (Source/ has the GameCube's renderer and files),
# and its replacement graphics (mods.cpp; Source/engine_unused.cpp stands in).
EXCLUDE		:=	renderer.cpp gl.cpp offscreen.cpp files.cpp crash.cpp png.cpp dump.cpp mods.cpp

# -ffp-contract=off: no fused multiply-adds, so the float arithmetic rounds
# like castle.exe's (SSE) does.
CFLAGS	= -g -O2 -Wall -ffp-contract=off $(MACHDEP) $(INCLUDE) -DPLATFORM_GAMECUBE=1 -DPLATFORM_DOLPHIN=1 -DAPI_GX=1
CXXFLAGS	=	$(CFLAGS) -std=gnu++20

# Test builds: AUTOPRESS=N presses A every N ticks (Source/CastleGame.cpp).
ifneq ($(AUTOPRESS),)
CFLAGS	+=	-DCASTLE_AUTOPRESS=$(AUTOPRESS)
# (and scratch memory filled with junk, as the console's is: new_gc.cpp;
# and the diagnostics on)
CFLAGS	+=	-DPPGC_POISON -DPPGC_DIAG -DPPGC_SD_LOG
endif
# DIAG=1: the diagnostics that cost time (docs/hardware-testing.md): the
# flicker detector and filmstrip, display lists checked in memory, each mesh
# logged, the heap census. Off in a disc for playing.
ifneq ($(DIAG),)
CFLAGS	+=	-DPPGC_DIAG -DPPGC_SD_LOG
endif
# GECKOLOG=1: the log, live over a USB Gecko in a memory card slot (to
# DolphinWorks' Debug console, or any program on its COM port): Octave's and
# PPGC's lines, the diagnostics' too. Never makes the game wait; with nothing
# reading on the PC, lines are dropped. The Gecko takes a slot from the cards.
ifneq ($(GECKOLOG),)
CFLAGS	+=	-DOCT_GECKO_LOG=1
endif
# SDLOG=1: the log written to the SD card, /ppgc.log (and /ppgc_stall.log if
# the game stops): file reads, loads, sound, the performance every two
# seconds, out of memory (Source/trace_gc.cpp). Without it nothing is written
# to the card. On in diagnostic and test builds, whose output goes there.
ifneq ($(SDLOG),)
CFLAGS	+=	-DPPGC_SD_LOG
endif
# CARDTEST=1 walks into the Save / Load page, saves, loads and leaves it.
ifneq ($(CARDTEST),)
CFLAGS	+=	-DCASTLE_CARDTEST=1 -DPPGC_SD_LOG
endif
# REPLAY=1 plays Scripts/Data/replay.bin (tools/make_replay.py, from a
# recorded session) instead of the pads, from the session's save, the Memory
# Card untouched; the pads take over when it runs out (Source/replay_gc.cpp).
ifneq ($(REPLAY),)
CFLAGS	+=	-DCASTLE_REPLAY=1 -DPPGC_SD_LOG
endif
# --gc-sections: what nothing uses stays out (the engine library's parts
# PPGC doesn't use). --no-eh-frame-hdr: no lookup table for the exception
# frames (65 KB): the unwinder searches the frames registered at start
# (__register_frame_info), and nothing here reads the table
# (docs/memory-roadmap.md, 1e).
LDFLAGS	=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--gc-sections -Wl,--no-eh-frame-hdr

# No -lbba: Source/octave_unused.cpp stands in for Octave's network code.
LIBS	:=	-lEngine -lBullet -lasnd -lfat -logc -lm

# GDB=1 (Debug (GDB) in DolphinWorks): libogc's debug stub linked in, on the USB Gecko. The game waits at
# its start for GDB (DolphinWorks' Start GDB), then runs under it: breakpoints, and a crash stops in GDB at
# its line. GDB has the Gecko to itself: no Gecko log in this build.
ifneq ($(GDB),)
CFLAGS	+=	-DOCT_GDB=1
LIBS	:=	-ldb $(LIBS)
endif

# The engine without what Castle Crashers never uses (Octave's
# Source/Engine/EngineFeatures.h; the list is Engine/OctFeatures.mk): no
# physics (Bullet), navigation (Recast/Detour), Ogg Vorbis, networking, video,
# splines, skeletal meshes, particles, instanced meshes, 3D text, the extra
# widgets, the on-screen console or the stats overlay -- about 1.3 MB of code
# and Bullet's 240 KB of pools at start, main memory the levels need
# (docs/memory-roadmap.md). Its own library, built on the way
# (Engine/Build/GCN_nophysics_nonav_...).
export OCT_PHYSICS := 0
export OCT_NAVIGATION := 0
export OCT_VORBIS := 0
export OCT_NETWORK := 0
export OCT_VIDEO := 0
export OCT_SPLINES := 0
export OCT_SKELETAL := 0
export OCT_PARTICLES := 0
export OCT_INSTANCING := 0
export OCT_TEXT3D := 0
export OCT_UI_EXTRAS := 0
export OCT_CONSOLE := 0
export OCT_STATS := 0
export OCT_LUA := 0
include $(OCTAVE)/Engine/OctFeatures.mk
CFLAGS	+=	$(OCT_DEFINES)

ENGINE_LIB_DIR := $(OCTAVE)/Engine/Build/GCN$(OCT_VARIANT)
BULLET_LIB_DIR := $(OCTAVE)/External/Bullet/Build/GCN

ifneq ($(notdir $(BUILD)),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export VPATH	:=	$(foreach dir,$(SOURCES),$(abspath $(dir)))
export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(filter-out $(EXCLUDE),$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp))))

export LD	:=	$(CXX)
export OFILES	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

# The engine's headers first: Octave's Engine/Source has Audio/ and Input/,
# which a case-insensitive file system would take for audio/ and input/.
export INCLUDE	:=	-I$(CURDIR)/Source/shim \
					-I$(CASTLE) \
					-I$(CURDIR)/Source \
					-I$(DEPS)/libtess2-src/Include \
					-I$(DEPS)/stb-src \
					-I$(OCTAVE)/Engine/Source \
					-I$(OCTAVE)/Engine/Source/Engine \
					-I$(OCTAVE)/External \
					-I$(OCTAVE)/External/Bullet \
					-I$(CURDIR)/$(BUILD) \
					-I$(LIBOGC_INC)

export LIBPATHS	:=	-L$(ENGINE_LIB_DIR) -L$(BULLET_LIB_DIR) -L$(LIBOGC_LIB)

export ENGINE_LIB := $(ENGINE_LIB_DIR)/libEngine.a
export OUTPUT	:=	$(OUTPUT_DIR)/$(TARGET)

.PHONY: $(BUILD) OutputDir EngineLib clean

$(BUILD): OutputDir EngineLib
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile_GCN

OutputDir:
	@[ -d $(OUTPUT_DIR) ] || mkdir -p $(OUTPUT_DIR)

# The engine library built as above (up to date: nothing to do).
EngineLib:
	@$(MAKE) --no-print-directory -C $(OCTAVE)/Engine -f Makefile_GCN

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT).dol $(OUTPUT).elf

#---------------------------------------------------------------------------------
else

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(ENGINE_LIB)

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
